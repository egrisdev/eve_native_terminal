// Icon, manifest and version info for both exes.
// build.sh compiles this twice: plain for evewt.exe, -DEVEWT_CONSOLE for evewt-console.exe.
#include <winver.h>
#include "version.h"

#ifdef EVEWT_CONSOLE
#define EVEWT_DESCRIPTION "EVE Windows Terminal console"
#define EVEWT_FILENAME "evewt-console.exe"
#else
// Browsers and Settings show this as the handler's name.
#define EVEWT_DESCRIPTION "EVE Windows Terminal"
#define EVEWT_FILENAME "evewt.exe"
#endif

1 ICON "eve-wt.ico"
1 24 "evewt.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION EVEWT_VERSION_COMMA
PRODUCTVERSION EVEWT_VERSION_COMMA
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "EVE-WT"
            VALUE "FileDescription", EVEWT_DESCRIPTION
            VALUE "FileVersion", EVEWT_VERSION_STRING
            VALUE "OriginalFilename", EVEWT_FILENAME
            VALUE "ProductName", "EVE Windows Terminal"
            VALUE "ProductVersion", EVEWT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
